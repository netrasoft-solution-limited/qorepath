# Database — either a single connection string (Neon) or the individual DB_* settings for local Postgres.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=qorepath
DB_SSL=false

JWT_SECRET=
JWT_EXPIRES_IN=7d

# Encrypts credentials saved from the admin Integrations screen (Paystack, Resend). Never change once set.
CONFIG_ENCRYPTION_KEY=

PORT=3005

# Comma-separated frontend origins allowed to call the API (defaults to localhost:5173-5175)
CORS_ORIGINS=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:5173/learner/payments/callback
FRONTEND_URL=http://localhost:5173

# Email (Resend). Without these, emails are skipped and logged instead.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. QorePath <noreply@yourdomain.com>
MAIL_FROM=

# 8x8 JaaS (Jitsi as a Service)
JAAS_APP_ID=
JAAS_KID=
JAAS_PRIVATE_KEY_PATH=./jaas-private-key.pem
JAAS_WEBHOOK_SECRET=
